    "/api/assistant/ask": {
      "post": {
        "tags": [
          "assistant"
        ],
        "summary": "Answer an applicant question from the official FAQ",
        "operationId": "ask_api_assistant_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "504": {
            "description": "No answer within the time budget.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "A parameter or the request body is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error_code": "INVALID_REQUEST",
                  "message": "question: String should have at least 1 character"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable. The request can be retried; the Retry-After header suggests a delay in seconds (currently 5).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error_code": "DATABASE_UNAVAILABLE",
                  "message": "The service is temporarily unavailable. Please try again."
                }
              }
            }
          }
        }
      }
    },
    "/api/assistant/ask/stream": {
      "post": {
        "tags": [
          "assistant"
        ],
        "summary": "Answer an applicant question as a stream of server-sent events",
        "operationId": "ask_stream_api_assistant_ask_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Server-sent events: `chunk` events with the answer text, then one `done` event with answer_id and sources. See docs/api/assistant-stream.md.",
            "content": {
              "text/event-stream": {}
            }
          },
          "504": {
            "description": "No answer within the time budget.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "A parameter or the request body is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error_code": "INVALID_REQUEST",
                  "message": "question: String should have at least 1 character"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable. The request can be retried; the Retry-After header suggests a delay in seconds (currently 5).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error_code": "DATABASE_UNAVAILABLE",
                  "message": "The service is temporarily unavailable. Please try again."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerSource": {
        "properties": {
          "faq_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Faq Id"
          },
          "question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "link": {
            "type": "string",
            "title": "Link"
          }
        },
        "type": "object",
        "required": [
          "faq_id",
          "question",
          "link"
        ],
        "title": "AnswerSource"
      },
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "session_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Session Id"
          }
        },
        "type": "object",
        "required": [
          "question",
          "session_id"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/AnswerSource"
            },
            "type": "array",
            "title": "Sources",
            "default": []
          },
          "source_link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Link"
          },
          "faq_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Faq Id"
          },
          "similarity_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Similarity Score"
          },
          "answer_id": {
            "type": "string",
            "title": "Answer Id"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "source_link",
          "faq_id",
          "similarity_score",
          "answer_id"
        ],
        "title": "AskResponse"
      },
      "ChecklistResponse": {
        "properties": {
          "program_id": {
            "type": "string",
            "title": "Program Id"
          },
          "applicant_type": {
            "type": "string",
            "enum": [
              "local",
              "international"
            ],
            "title": "Applicant Type"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/DocumentRequirementOut"
            },
            "type": "array",
            "title": "Items"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warning"
          },
          "contact": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact"
          }
        },
        "type": "object",
        "required": [
          "program_id",
          "applicant_type",
          "items"
        ],
        "title": "ChecklistResponse"
      },
      "DocumentRequirementOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "format": {
            "type": "string",
            "enum": [
              "original",
              "copy"
            ],
            "title": "Format"
          },
          "translation": {
            "type": "boolean",
            "title": "Translation"
          },
          "notarisation": {
            "type": "boolean",
            "title": "Notarisation"
          },
          "deadline": {
            "type": "string",
            "title": "Deadline"
          }
        },
        "type": "object",
        "required": [
          "name",
          "format",
          "translation",
          "notarisation",
          "deadline"
        ],
        "title": "DocumentRequirementOut"
      },
      "ErrorResponse": {
        "properties": {
          "error_code": {
            "type": "string",
            "title": "Error Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "error_code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "FeedbackRequest": {
        "properties": {
          "answer_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,17}$",
            "title": "Answer Id"
          },
          "session_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Session Id"
          },
          "rating": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "title": "Rating"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "outdated",
                  "incorrect",
                  "incomplete",
                  "unclear",
                  "wrong",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "answer_id",
          "session_id",
          "rating"
        ],
        "title": "FeedbackRequest"
      },
      "FeedbackResponse": {
        "properties": {
          "answer_id": {
            "type": "string",
            "title": "Answer Id"
          },
          "rating": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "title": "Rating"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "answer_id",
          "rating",
          "reason"
        ],
        "title": "FeedbackResponse"
      },
      "ProgramListResponse": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "programs": {
            "items": {
              "$ref": "#/components/schemas/ProgramOut"
            },
            "type": "array",
            "title": "Programs"
          }
        },
        "type": "object",
        "required": [
          "total",
          "programs"
        ],
        "title": "ProgramListResponse"
      },
      "ProgramOut": {
        "properties": {
          "program_id": {
            "type": "string",
            "title": "Program Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "faculty": {
            "type": "string",
            "title": "Faculty"
          },
          "degree_level": {
            "type": "string",
            "enum": [
              "bachelor",
              "master",
              "phd"
            ],
            "title": "Degree Level"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "tuition_per_ects_kzt": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tuition Per Ects Kzt"
          },
          "tuition_per_ects_usd": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tuition Per Ects Usd"
          },
          "deadline_local": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline Local"
          },
          "deadline_international": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline International"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          }
        },
        "type": "object",
        "required": [
          "program_id",
          "title",
          "faculty",
          "degree_level",
          "language",
          "tuition_per_ects_kzt",
          "tuition_per_ects_usd",
          "deadline_local",
          "deadline_international",
          "source_url",
          "is_active"
        ],
        "title": "ProgramOut"
      },
      "SuggestionsResponse": {
        "properties": {
          "suggestions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Suggestions"
          }
        },
        "type": "object",
        "required": [
          "suggestions"
        ],
        "title": "SuggestionsResponse"
      }
    }
  }
}
