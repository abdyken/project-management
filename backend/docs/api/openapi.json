            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "A parameter or the request body is invalid.",
            "content": {
              "application/json": {
                "example": {
                  "error_code": "INVALID_REQUEST",
                  "message": "question: String should have at least 1 character"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable. The request can be retried; the Retry-After header suggests a delay in seconds (currently 5).",
            "content": {
              "application/json": {
                "example": {
                  "error_code": "DATABASE_UNAVAILABLE",
                  "message": "The service is temporarily unavailable. Please try again."
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/assistant/feedback": {
      "post": {
        "tags": [
          "assistant"
        ],
        "summary": "Rate a stored assistant answer once",
        "operationId": "feedback_api_assistant_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackResponse"
                }
              }
            }
          },
          "404": {
            "description": "Answer id is unknown.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "This answer has already been rated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "A parameter or the request body is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error_code": "INVALID_REQUEST",
                  "message": "question: String should have at least 1 character"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable. The request can be retried; the Retry-After header suggests a delay in seconds (currently 5).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error_code": "DATABASE_UNAVAILABLE",
                  "message": "The service is temporarily unavailable. Please try again."
                }
              }
            }
          }
        }
      }
    },
