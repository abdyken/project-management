# Copy to .env and fill in real values locally / in CI secrets.
# Never commit the real .env file.

# --- Database and app ---
# The root docker-compose.yml publishes Postgres on localhost:5432 (user, password, db: admissions).
DATABASE_URL=postgresql+psycopg://admissions:admissions@localhost:5432/admissions

# Comma-separated list of front-end origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Assistant (US3) ---
FAQ_DATA_PATH=app/data/faq.json
# Cosine similarity below which the assistant answers with the admissions contact (T3.4)
SIMILARITY_THRESHOLD=0.5
# Whole answer including the model call; keep it above GEMINI_TIMEOUT_SECONDS
ASSISTANT_TIMEOUT_SECONDS=15.0
# US14: pause between streamed answer chunks in seconds (0 = none); long answers still finish within 2 s
STREAM_CHUNK_DELAY_SECONDS=0.02
ADMISSIONS_OFFICE_CONTACT=SDU Admissions Office, Abylai Khan 1/1, 040900 Kaskelen. Tel. +7 727 307 95 65

# --- Grounded answers with Gemini (US10), free tier only ---
# Free Google AI Studio key (https://aistudio.google.com/apikey), no billing account.
# Leave empty locally to get the word-for-word FAQ answers of Sprint 1.
# On the deployed site the key is set only in the Render environment, never committed.
GEMINI_API_KEY=
# Free models tried in order; the next one answers when a model hits its free limit (429) or is overloaded (503)
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.5-flash
# One model call, at least 10 (the API rejects shorter deadlines); on timeout or API error
# the assistant returns the FAQ answer word for word
GEMINI_TIMEOUT_SECONDS=10.0
# low / medium / high (minimal is not accepted by every model), or empty for the model default
GEMINI_THINKING_LEVEL=low
# FAQ items above SIMILARITY_THRESHOLD sent to the model as sources
GROUNDING_TOP_K=5
