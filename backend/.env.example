# Copy to .env and fill in real values locally / in CI secrets.
# Never commit the real .env file.

# --- T0.3: database and app ---
# Local docker-compose database (matches docker-compose.yml)
POSTGRES_USER=admissions
POSTGRES_PASSWORD=admissions
POSTGRES_DB=admissions

# Host port published by docker compose. Use another port if 5432 is already taken.
POSTGRES_PORT=5432

# SQLAlchemy URL used by the API and Alembic.
# Inside docker-compose the host is "db"; when running the API on your machine use "localhost".
# If POSTGRES_PORT is not 5432, use that port here too.
DATABASE_URL=postgresql+psycopg://admissions:admissions@localhost:5432/admissions

APP_ENV=local
# Comma-separated list of front-end origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- T0.7: LLM provider (answer generation) ---
LLM_PROVIDER=mock          # mock | anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_SPENDING_LIMIT_USD=20

# --- T0.7: Embedding provider (retrieval) ---
EMBEDDING_PROVIDER=mock    # mock | openai | voyage
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Assistant behaviour ---
SIMILARITY_THRESHOLD=0.72
ASSISTANT_TIMEOUT_SECONDS=4.0
ADMISSIONS_OFFICE_CONTACT=SDU Admissions Office, Abylai Khan 1/1, 040900 Kaskelen. Tel. +7 727 307 95 65

# --- Catalogue the assistant reads (db = this API's database; empty = JSON fixtures) ---
FAQ_DATA_PATH=app/data/faq_sample.json
FAQ_INDEX_PATH=app/data/faq_index.json
CATALOG_API_URL=db
CHECKLIST_API_URL=db

# --- Retrieval index storage (T3.2): file | postgres ---
INDEX_BACKEND=file
