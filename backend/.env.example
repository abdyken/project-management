# Copy to .env and adjust. Never commit the real .env.

# Local docker-compose database (matches docker-compose.yml)
POSTGRES_USER=admissions
POSTGRES_PASSWORD=admissions
POSTGRES_DB=admissions

# SQLAlchemy URL used by the API and Alembic.
# In docker-compose the host is "db"; when running the API on your machine use "localhost".
DATABASE_URL=postgresql+psycopg://admissions:admissions@db:5432/admissions

APP_ENV=local
# Comma-separated list of front-end origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
